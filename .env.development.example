# Local developer sandbox profile
# Use with: OIAT_ENV_FILE=.oiat/env/<profile>.env ./build/run-local.sh
# Or simply: ./build/run-sandbox.sh  (defaults to .oiat/env/marvin-dev.env)

COMPOSE_PROJECT_NAME=oiat-dev

# Stable local-disk state root — survives reboots.
# ~ is expanded by code_scripts/paths.py. Do NOT use /tmp (cleared on reboot =
# lost sandbox tokens, run history, and Django DB).
# Note: the mounted shared network drive does not support SQLite locking, so
# keep STATE_ROOT on a local-disk path (~/.oiat/...) even when the repo itself
# lives on a mount.
STATE_ROOT=~/.oiat/state/dev
OIAT_COMPANIES_DIR=~/.oiat/state/dev/code_scripts/companies
OIAT_RUNTIME_ENV=sandbox

# Intuit Development app credentials (NOT the production app).
# Get these from developer.intuit.com under your "Development" keys.
QBO_CLIENT_ID=replace_with_intuit_development_client_id
QBO_CLIENT_SECRET=replace_with_intuit_development_client_secret
# Intuit Webhooks verifier token for sandbox/development webhook tests.
QBO_WEBHOOK_VERIFIER_TOKEN=replace_with_intuit_development_webhook_verifier_token

# Local Django settings
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-local-dev-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_USE_X_FORWARDED_PROTO=0
DJANGO_USE_X_FORWARDED_HOST=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SESSION_COOKIE_SECURE=0
WEBSITE_LOGS_PUBLIC_BASE_URL=

# Local Docker binding for docker-compose.dev.yml
WEB_BIND_HOST=127.0.0.1
WEB_BIND_PORT=8000

# Path to the Python venv used by dashboard subprocesses (runserver, job_runner
# subprocess dispatches). Must match production Python (3.11) to avoid
# framework incompatibilities. Build with:
#   uv python install 3.11
#   uv venv --python 3.11 ~/.oiat/venv/dev
#   ~/.oiat/venv/dev/bin/python -m ensurepip --upgrade
#   ~/.oiat/venv/dev/bin/python -m pip install -r requirements.txt
#   ~/.oiat/venv/dev/bin/python -m playwright install chromium
OIAT_VENV_PATH=~/.oiat/venv/dev
OIAT_RUNSERVER_ARGS=--noreload

# Sandbox EPOS credentials.
# NOTE: EPOS Now does not provide a sandbox EPOS tenant. If you want realistic
# test data you'll reuse a real EPOS login here — downloads are read-only, so
# production EPOS data is safe, and the uploaded data goes to the QBO *sandbox*
# realm (never prod). If you want fully fake data instead, point this at a
# throwaway EPOS account and accept that the sandbox won't mirror real sales.
EPOS_USERNAME_A=replace_with_sandbox_epos_username
EPOS_PASSWORD_A=replace_with_sandbox_epos_password

# Optional Slack webhooks
# These names are referenced by company JSON slack.webhook_url_env_key.
SLACK_WEBHOOK_URL_A=
SLACK_WEBHOOK_URL_B=

# Optional QuickBooks webhook Slack destinations, separate from pipeline Slack.
QBO_WEBHOOK_SLACK_URL_COMPANY_A=
QBO_WEBHOOK_SLACK_URL_COMPANY_B=
QBO_WEBHOOK_SLACK_URL_TEST=
QBO_WEBHOOK_SLACK_URL=

# Scheduler worker
OIAT_SCHEDULER_POLL_SECONDS=15
OIAT_SCHEDULER_ENABLE_ENV_FALLBACK=1
SCHEDULE_CRON="0 18 * * *"
SCHEDULE_TZ=Africa/Lagos
